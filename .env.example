# PostgreSQL 16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms"
# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Optional: Google SSO (provider is enabled only when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: Redis for caching + BullMQ jobs (falls back to in-memory cache and inline jobs)
REDIS_URL=""
# Optional: S3-compatible storage for uploads (falls back to local ./public/uploads in dev)
S3_BUCKET=""
